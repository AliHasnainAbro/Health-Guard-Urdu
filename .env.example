# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM access — confirm with team lead before setting: Qoder built-in model access
# vs a separate Alibaba Cloud Qwen API key. Do not default without asking.
LLM_PROVIDER=qoder
QWEN_API_KEY=

# TTS — Alibaba Cloud Intelligent Speech Interaction
ALIBABA_TTS_ACCESS_KEY_ID=
ALIBABA_TTS_ACCESS_KEY_SECRET=
ALIBABA_TTS_APPKEY=
