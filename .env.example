# Supabase — vector store for the knowledge base (pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM — Alibaba Cloud Qwen via DashScope (OpenAI-compatible API)
# Used for classification, Roman Urdu normalization, and transliteration.
# Get a key at https://dashscope.console.aliyun.com/ (intl) — no other LLM keys needed.
QWEN_API_KEY=your-qwen-api-key

# TTS — gTTS (Google Text-to-Speech): no API key required.
# Optional future upgrade: Alibaba Cloud Intelligent Speech Interaction
# (ALIBABA_TTS_ACCESS_KEY_ID, ALIBABA_TTS_ACCESS_KEY_SECRET, ALIBABA_TTS_APPKEY)
