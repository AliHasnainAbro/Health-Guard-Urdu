# Supabase — vector store for the knowledge base (pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM — Alibaba Model Studio Qwen (OpenAI-compatible API)
# Used for classification, Roman Urdu normalization, and transliteration.
# Create a key in the Singapore workspace shown in Model Studio.
LLM_API_KEY=your-alibaba-api-key
LLM_BASE_URL=https://ws-de23fer3gmw7ckpd.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max-2026-06-08
LLM_FALLBACK_MODEL=qwen3.6-plus

# Comma-separated browser origins allowed to call the API.
# Example: https://your-username-your-space.hf.space
FRONTEND_ORIGINS=

# TTS — gTTS (Google Text-to-Speech): no API key required.
# Optional future upgrade: Alibaba Cloud Intelligent Speech Interaction
# (ALIBABA_TTS_ACCESS_KEY_ID, ALIBABA_TTS_ACCESS_KEY_SECRET, ALIBABA_TTS_APPKEY)
